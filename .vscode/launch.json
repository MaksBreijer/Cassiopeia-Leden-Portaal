{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cassiopeia website",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000",
        "HOST": "127.0.0.1"
      },
      "serverReadyAction": {
        "pattern": "Cassiopeia draait op (http://.*)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
